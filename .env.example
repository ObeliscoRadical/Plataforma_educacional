# ==========================================
# DEVELOPER OS - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port (Railway will set PORT automatically)
PORT=4050
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=devos-secret-super-secure-production-key-change-me

# SQLite Database File Path
DATABASE_PATH=./data/developer_os.sqlite

# Google Gemini API Key (Required for AI Socratic Mentor)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# Fish Audio / TTS (Optional - Falls back to Free Neural TTS automatically)
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=b59c8403f2354d46ba0003589b947316
