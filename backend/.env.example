# ==========================================
# PLATAFORMA EDUCACIONAL (DEVELOPER OS)
# Environment Configuration for Railway + MongoDB
# ==========================================

# Server Port (Railway sets PORT automatically)
PORT=4050
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=devos-super-secret-jwt-key-2026-matrix-omega

# Database Configuration (Railway MongoDB plugin provides MONGODB_URI automatically)
MONGODB_URI=mongodb://mongo:password@containers-us-west-1.railway.app:7000
DATABASE_PATH=./data/developer_os.sqlite

# Google Gemini API Key (Required for AI Socratic Mentor)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# Stripe Gateway (Plan Cadete Pro R$ 9,90/mês)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_developer_os_990_monthly
APP_BASE_URL=https://plataforma-educacional-production.up.railway.app

# Free Neural Voice / Fish Audio (Optional)
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=0ba1afd27db44eb2b4cb27fd331b93aa
FISH_AUDIO_MODEL=s2.1-pro-free
